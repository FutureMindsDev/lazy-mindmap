# ==============================================================================
# LazyMindmap — Firebase Auth (Spark) + MongoDB Atlas (M0 Free), Security & AI
# Copy to `.env` or `.env.local` and fill in your credentials.
# ==============================================================================

# --- Client (Vite Web SDK — Firebase Auth for Email, Google, Facebook) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=lazy-mindmap.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lazy-mindmap
VITE_FIREBASE_STORAGE_BUCKET=lazy-mindmap.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloud Database: MongoDB Atlas (M0 Free Tier, 512 MB, no daily read/write cap) ---
# When MONGODB_URI is set, all users, cloud maps, BYOK vault, trials, KBZPay payments,
# compressed KBZPay receipt screenshots, and admin config are stored in MongoDB Atlas.
MONGODB_URI=
MONGODB_DB_NAME=lazymindmap

# --- Server Firebase Auth Verification ---
# With MongoDB Atlas, setting FIREBASE_PROJECT_ID=lazy-mindmap is enough to verify
# Firebase ID tokens. (Add FIREBASE_SERVICE_ACCOUNT_JSON or GOOGLE_APPLICATION_CREDENTIALS
# only if you prefer Cloud Firestore instead of MongoDB.)
FIREBASE_PROJECT_ID=lazy-mindmap
FIREBASE_STORAGE_BUCKET=lazy-mindmap.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Encryption & Anti-Abuse Signing ---
# 32-byte hex (generate with: openssl rand -hex 32)
BYOK_ENCRYPTION_KEY=

# --- Server-Side Managed & Trial Gemini API Keys (never exposed to browser) ---
# Can also be updated dynamically from the Admin Dashboard (stored encrypted in MongoDB/Firestore)
GEMINI_MANAGED_API_KEY=
GEMINI_TRIAL_API_KEY=

# --- Admin Access & Server Security ---
# Comma-separated list of admin email addresses
ADMIN_EMAILS=
# Set to "false" if not running behind a reverse proxy (Cloudflare / Nginx / Vercel / Cloud Run)
TRUST_PROXY=true
# Set to "false" in production to disable local dev preview sign-in tokens
ALLOW_DEV_AUTH=true
# Optional: allow http://localhost custom BYOK base URLs in self-hosted setups
ALLOW_LOCAL_LLM_URL=false
NODE_ENV=development
